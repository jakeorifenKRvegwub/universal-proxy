export default {
  async fetch(request) {
    // Handle CORS preflight
    if (request.method === "OPTIONS") {
      return new Response(null, {
        headers: {
          "Access-Control-Allow-Origin": "*",
          "Access-Control-Allow-Methods": "GET, POST, PUT, DELETE, PATCH, HEAD, OPTIONS",
          "Access-Control-Allow-Headers": "*",
          "Access-Control-Max-Age": "86400",
        },
      });
    }

    const corsHeaders = {
      "Access-Control-Allow-Origin": "*",
      "Access-Control-Expose-Headers": "*",
    };

    const url = new URL(request.url);

    // Determine target: path-based (/https://...) or query-based (?url=https://...)
    let targetUrl;
    const pathParam = url.pathname.startsWith("/") ? url.pathname.slice(1) : url.pathname;

    if (pathParam && (pathParam.startsWith("http://") || pathParam.startsWith("https://"))) {
      targetUrl = pathParam + (url.search || "");
    }
    if (!targetUrl) {
      const queryUrl = url.searchParams.get("url");
      if (queryUrl) targetUrl = queryUrl;
    }

    // No target → show usage info
    if (!targetUrl) {
      return new Response(JSON.stringify({
        service: "Universal Proxy",
        usage: [
          "Path:  https://<worker>.workers.dev/https://example.com/api",
          "Query: https://<worker>.workers.dev/?url=https://example.com/api",
        ],
        methods: "GET, POST, PUT, DELETE, PATCH, HEAD, OPTIONS",
        cors: "Enabled",
      }, null, 2), {
        headers: { ...corsHeaders, "Content-Type": "application/json" },
      });
    }

    // Validate URL
    let parsedUrl;
    try {
      parsedUrl = new URL(targetUrl);
    } catch {
      return new Response(JSON.stringify({ error: "Invalid target URL", provided: targetUrl }), {
        status: 400,
        headers: { ...corsHeaders, "Content-Type": "application/json" },
      });
    }

    // Build forwarded request
    const reqHeaders = new Headers(request.headers);
    reqHeaders.set("Host", parsedUrl.host);
    ["cf-connecting-ip", "cf-ipcountry", "cf-ray", "cf-visitor",
     "x-forwarded-for", "x-forwarded-proto", "x-real-ip"].forEach(h => reqHeaders.delete(h));

    const fetchOptions = {
      method: request.method,
      headers: reqHeaders,
      redirect: "follow",
    };

    if (!["GET", "HEAD"].includes(request.method)) {
      fetchOptions.body = request.body;
    }

    try {
      const response = await fetch(parsedUrl.href, fetchOptions);

      const respHeaders = new Headers(response.headers);
      respHeaders.set("Access-Control-Allow-Origin", "*");
      respHeaders.set("Access-Control-Expose-Headers", "*");

      return new Response(response.body, {
        status: response.status,
        statusText: response.statusText,
        headers: respHeaders,
      });
    } catch (err) {
      return new Response(JSON.stringify({
        error: "Failed to fetch target URL",
        message: err.message,
        target: parsedUrl.href,
      }), {
        status: 502,
        headers: { ...corsHeaders, "Content-Type": "application/json" },
      });
    }
  },
};
